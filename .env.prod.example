# MindRouter Production Environment Configuration
# Copy to .env.prod and fill in secure values

# =============================================================================
# APPLICATION
# =============================================================================
# Public HTTPS origin where users reach MindRouter (no trailing slash).
# CHANGE THIS -- do not deploy the placeholder.
# Every OIDC and Google redirect URI, and the SAML Destination/Recipient
# validation, are derived from this value. A wrong-but-plausible value FAILS
# SILENTLY on this side: MindRouter builds a redirect URI against the wrong
# origin and the *IdP* is what rejects it, so the symptom is a
# redirect_uri_mismatch (or a SAML Destination mismatch) that looks like an IdP
# fault rather than a local misconfiguration. Leaving it blank is also wrong:
# the code then falls back to the incoming request's scheme/Host headers.
# Compose reads these values from the .env file sitting next to the compose file
# on the deployment host (in the reference deployment: /opt/mindrouter/.env).
APP_BASE_URL=https://mindrouter.example.edu

# =============================================================================
# DATABASE (MariaDB container)
# =============================================================================
DATABASE_URL=mysql+pymysql://mindrouter:CHANGE_THIS_DB_PASSWORD@mariadb:3306/mindrouter
# Each uvicorn worker has its OWN pool. Keep
#   UVICORN_WORKERS x (DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW)
# well under MariaDB max_connections (512), leaving room for the mcp
# container and admin clients. Then a worker that runs out of connections
# waits (pool_timeout, 10 s) and fails only its own request, instead of
# MariaDB refusing connections to everyone (error 1040 — the 2026-11-05
# outage, when 8 workers x (60 + 60) = 960 could be requested of 512).
# 8 workers x (20 + 25) = 360.
UVICORN_WORKERS=8
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=25

# MariaDB container settings
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
MYSQL_DATABASE=mindrouter
MYSQL_USER=mindrouter
MYSQL_PASSWORD=CHANGE_THIS_DB_PASSWORD

# =============================================================================
# REDIS
# =============================================================================
# REDIS_PASSWORD is MANDATORY in production: docker-compose.prod.yml starts
# redis with --requirepass ${REDIS_PASSWORD:?...}, so every `docker compose`
# command fails fast if it is unset. Generate a strong value and use the SAME
# value in REDIS_URL below (they must match).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379/0

# Multi-worker production: keep the fleet-wide rate/admission limits authoritative
# in Redis rather than degrading to per-worker in-memory counters on an outage.
RATE_LIMIT_LOCAL_FALLBACK=false

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# Do NOT publish the interactive API docs / OpenAPI schema in production.
ENABLE_API_DOCS=false

# Extra origins trusted for state-changing (CSRF-protected) browser requests,
# beyond APP_BASE_URL. JSON list of scheme+host origins; empty for a
# single-origin deployment.
CSRF_TRUSTED_ORIGINS=[]

# -----------------------------------------------------------------------------
# Input limits / hardening (defaults preserve current behavior; tighten as needed)
# -----------------------------------------------------------------------------
# Block image-URL fetches that resolve to private/loopback addresses (SSRF
# guard) and restrict accepted URL schemes for vision inputs and image edits.
IMAGE_URL_BLOCK_PRIVATE=true
IMAGE_URL_ALLOWED_SCHEMES=["http","https","data"]

# Max decoded frames/pages per OCR request.
OCR_MAX_FRAMES=500

# Max uncompressed size of an uploaded chat file after decompression, in MB
# (decompression-bomb guard, independent of CHAT_UPLOAD_MAX_SIZE_MB).
CHAT_UPLOAD_MAX_UNCOMPRESSED_MB=100

# Upper bound on the OpenAI-style `n` (number of completions) per request.
MAX_COMPLETIONS_N=8

# Login throttling: failed attempts per source within the rolling window
# (seconds) before further attempts are refused.
LOGIN_MAX_ATTEMPTS_PER_WINDOW=15
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# Max characters accepted by the /tokenize helper endpoint.
TOKENIZE_MAX_INPUT_CHARS=2000000

# =============================================================================
# SINGLE SIGN-ON (SSO)
# =============================================================================
# Not needed to start MindRouter, but REQUIRED if users are to sign in with
# campus credentials -- so treat it as part of a production deployment, not an
# afterthought. Providers are enabled purely by the variables below (there is no
# admin-UI toggle); any subset may be enabled at once, and local
# username/password accounts always remain available on the login page.
#
# Before configuring any provider:
#   - Set APP_BASE_URL (APPLICATION section above) FIRST. Redirect URIs and the
#     SAML Destination check derive from it; a wrong value fails at the IdP.
#   - RESTART the app after changing any SSO variable (config is process-level
#     and cached per worker).
#   - Run `alembic upgrade head` after upgrading (migration 068 adds
#     users.sso_provider / users.sso_subject).
#   - JIT provisioning puts a first-time SSO user in that provider's
#     *_DEFAULT_GROUP. THE GROUP MUST ALREADY EXIST -- create it on the admin
#     Groups page first, which means you need an admin account before SSO works.
#   - SECRET_KEY (SECURITY section) signs the SSO state/request cookies; a weak
#     or shared key weakens SSO, and rotating it breaks in-flight logins.
#
# Full walkthrough, IdP-side steps and troubleshooting:
#   docs/sso-configuration.md
# .env.example carries the complete annotated variable list, including the
# per-provider gotchas; only the variables most deployments need are repeated
# here.

# Azure AD / Entra ID -- set CLIENT_ID + TENANT_ID to enable.
# AZURE_AD_REDIRECT_URI is NOT derived from APP_BASE_URL. Set it explicitly to
# an absolute URL that matches a Redirect URI registered on the Azure app
# registration exactly (scheme, host, path); under Compose an unset variable
# arrives as an empty string, so the code default never applies.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=https://mindrouter.example.edu/login/azure/authorized
AZURE_AD_DEFAULT_GROUP=other

# SAML 2.0 (Shibboleth / InCommon direct, ADFS) -- set SAML_SP_ENTITY_ID plus
# EITHER SAML_IDP_METADATA_URL (https only -- the metadata carries the signing
# certificate) OR the explicit IdP entity/SSO-URL/x509 trio documented in
# .env.example. Register <APP_BASE_URL>/saml/metadata with the IdP or
# federation. SP-initiated only (no IdP-initiated tiles, no SLO), requires TLS,
# and the IdP MUST release a persistent/stable NameID or users are permanently
# refused after their first login.
SAML_SP_ENTITY_ID=
SAML_IDP_METADATA_URL=
# Login button reads "Sign in with <display name>"
SAML_DISPLAY_NAME=SSO
SAML_DEFAULT_GROUP=other

# Generic OIDC (Okta, Keycloak, Auth0, CILogon) -- set ISSUER + CLIENT_ID +
# CLIENT_SECRET to enable. For InCommon, the recommended path is CILogon as the
# issuer (OIDC_SSO_ISSUER=https://cilogon.org, OIDC_SSO_DISPLAY_NAME=InCommon)
# with callback <APP_BASE_URL>/login/oidc/authorized -- one client registration
# replaces per-campus SAML metadata exchange.
OIDC_SSO_ISSUER=
OIDC_SSO_CLIENT_ID=
OIDC_SSO_CLIENT_SECRET=
OIDC_SSO_DISPLAY_NAME=SSO
OIDC_SSO_DEFAULT_GROUP=other

# Google (OIDC) -- set CLIENT_ID + CLIENT_SECRET to enable.
# GOOGLE_SSO_HOSTED_DOMAIN restricts login to a single Google Workspace domain
# (leave blank for no restriction).
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
GOOGLE_SSO_HOSTED_DOMAIN=
GOOGLE_SSO_DEFAULT_GROUP=other

# =============================================================================
# HOST STORAGE PATHS (compose bind-mount sources)
# =============================================================================
# These are directories ON THE DOCKER HOST -- the left-hand side of the compose
# bind mounts. They are NOT the same thing as the *_STORAGE_PATH variables
# below, which are the in-container paths the app writes to and normally should
# not change.
# Point these at whatever volume has room on this machine; absolute paths are
# usual in production (the reference deployment pins all three under
# /archivedb). The defaults below are relative to the compose file so that a
# fresh host works without prior setup.
# Docker creates a missing bind source as root, and the app runs as uid 1000, so
# create them first or artifact/logo writes fail after an apparently clean
# start:  mkdir -p <path> && chown -R 1000:1000 <path>
ARCHIVE_DB_HOST_PATH=./data/archive-mariadb
ARTIFACT_HOST_PATH=./data/artifacts
VIDEO_HOST_PATH=./data/video

# =============================================================================
# ARTIFACT STORAGE
# =============================================================================
# In-container path (matches ARTIFACT_HOST_PATH's mount target above)
ARTIFACT_STORAGE_PATH=/data/artifacts
ARTIFACT_MAX_SIZE_MB=50
ARTIFACT_RETENTION_DAYS=365

# =============================================================================
# QUOTAS AND LIMITS (adjust as needed)
# =============================================================================
DEFAULT_TOKEN_BUDGET_STUDENT=100000
DEFAULT_TOKEN_BUDGET_STAFF=500000
DEFAULT_TOKEN_BUDGET_FACULTY=1000000

DEFAULT_RPM_STUDENT=30
DEFAULT_RPM_STAFF=60
DEFAULT_RPM_FACULTY=120
DEFAULT_RPM_ADMIN=1000

DEFAULT_MAX_CONCURRENT_STUDENT=2
DEFAULT_MAX_CONCURRENT_STAFF=4
DEFAULT_MAX_CONCURRENT_FACULTY=8
DEFAULT_MAX_CONCURRENT_ADMIN=50

# =============================================================================
# SCHEDULER
# =============================================================================
SCHEDULER_WEIGHT_STUDENT=1
SCHEDULER_WEIGHT_STAFF=2
SCHEDULER_WEIGHT_FACULTY=3
SCHEDULER_WEIGHT_ADMIN=10
SCHEDULER_FAIRNESS_WINDOW=300
SCHEDULER_DEPRIORITIZE_THRESHOLD=0.5

# =============================================================================
# BACKEND REGISTRY
# =============================================================================
BACKEND_POLL_INTERVAL=30
BACKEND_HEALTH_TIMEOUT=5
BACKEND_UNHEALTHY_THRESHOLD=3

# =============================================================================
# REQUEST HANDLING
# =============================================================================
BACKEND_REQUEST_TIMEOUT=300

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/mindrouter/app.log
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PROMPTS=true
AUDIT_LOG_RESPONSES=true

# =============================================================================
# OBSERVABILITY
# =============================================================================
METRICS_ENABLED=true
METRICS_PREFIX=mindrouter

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
DEBUG=false
RELOAD=false
CORS_ORIGINS=["https://your-domain.example.com"]
