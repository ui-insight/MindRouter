FROM nvidia/cuda:12.4.0-base-ubuntu22.04

# Install Python and ipmitool (for server-level power monitoring via DCMI)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ipmitool && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY VERSION .
COPY gpu_agent.py .

# Run as a non-root user. The agent binds 8007 (>1024, no privilege needed).
# GPU access via --gpus works regardless of uid, but /dev/ipmi0 is root:root
# 0600 on the hosts, so deploy_sidecars.sh must pass --group-add <gid of a host
# group that owns the device> or server-power readings silently fall back to
# the GPU sum.
RUN useradd --create-home --shell /bin/bash --uid 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8007

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python3 -c "import os, urllib.request; req = urllib.request.Request('http://localhost:8007/health', headers={'X-Sidecar-Key': os.environ.get('SIDECAR_SECRET_KEY', '')}); urllib.request.urlopen(req)" || exit 1

CMD ["python3", "-m", "uvicorn", "gpu_agent:app", "--host", "0.0.0.0", "--port", "8007"]
