# /etc/mindrouter/mesh-worker-<instance>.env — read by BOTH systemd
# (EnvironmentFile: the MESH_* placement vars) and docker (--env-file: the
# MESH_WORKER_* vars inside the container). KEY=value, no quotes, no spaces.
# chmod 600 root:root: it holds the worker key. NEVER commit a filled copy.

# ---- placement (systemd) ---------------------------------------------------
# Physical GPU index (as nvidia-smi numbers it) and loopback port.
MESH_GPU=3
MESH_HOST_PORT=18401
# trellis2 image serves MESH_WORKER_MODE=trellis2 and pixal3d;
# hunyuan3d21 has its own image.
MESH_IMAGE=mindrouter-mesh-trellis2:0.1.0
# Read-only weights tree (see README "Staging weights"); must be readable by
# uid 10001. Scratch dir for outputs/caches: owned by uid 10001.
MESH_WEIGHTS_DIR=/data/mesh-weights
MESH_DATA_DIR=/data/mesh-worker/trellis2-gpu3

# ---- worker (container) ----------------------------------------------------
MESH_WORKER_MODE=trellis2
# Served model name = the gateway's model name.
MESH_WORKER_MODEL=microsoft/trellis.2-4b
# Local checkpoint dirs under the read-only /weights mount.
MESH_WORKER_CKPT=/weights/microsoft/TRELLIS.2-4B
MESH_WORKER_BIREFNET=/weights/ZhengPeng7/BiRefNet
MESH_WORKER_DINOV3=/weights/facebook/dinov3-vitl16-pretrain-lvd1689m
# Shared secret; the SAME value goes in the gateway's backend config.
MESH_WORKER_API_KEY=
MESH_WORKER_MAX_QUEUE=8
MESH_WORKER_JOB_TIMEOUT_SECONDS=900
MESH_WORKER_RESULT_TTL_SECONDS=86400

# pixal3d instead:
#   MESH_IMAGE=mindrouter-mesh-trellis2:0.1.0
#   MESH_WORKER_MODE=pixal3d
#   MESH_WORKER_MODEL=tencentarc/pixal3d
#   MESH_WORKER_CKPT=/weights/TencentARC/Pixal3D
#   MESH_WORKER_PIXAL3D_FOV=0        # 0 = estimate with MoGe-2 (MESH_WORKER_MOGE)
#   MESH_WORKER_MOGE=/weights/Ruicheng/moge-2-vitl
#
# hunyuan3d21 instead (weights staged as an HF cache under /weights/hf):
#   MESH_IMAGE=mindrouter-mesh-hunyuan3d21:0.1.0
#   MESH_WORKER_MODE=hunyuan3d21
#   MESH_WORKER_MODEL=tencent/hunyuan3d-2.1
#   MESH_WORKER_CKPT=tencent/Hunyuan3D-2.1
