# MindRouter Environment Configuration

# =============================================================================
# APPLICATION
# =============================================================================
# Public HTTPS origin where users reach MindRouter (no trailing slash).
# REQUIRED for correct SSO: OIDC/Google redirect URIs and the SAML
# Destination/Recipient validation are derived from this value rather than from
# the incoming request's scheme/Host headers, so a spoofed proxy header cannot
# influence them. That protection depends on this value being set: if it is
# left blank the code falls back to those request headers (the OIDC path honors
# X-Forwarded-Proto; the SAML path uses the request's own scheme plus Host),
# which is exactly why it should always be set in production.
APP_BASE_URL=https://mindrouter.example.edu

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=mysql+pymysql://mindrouter:mindrouter_password@localhost:3306/mindrouter
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS (rate limiting, caching, and fleet-wide admission counters)
# =============================================================================
# Redis now requires a password. Set REDIS_PASSWORD and keep it embedded in
# REDIS_URL (redis://:<password>@host:port/db). The compose redis service reads
# REDIS_PASSWORD too; a dev default is provided there so a fresh checkout works,
# but set a real value for anything beyond a laptop.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=mindrouter_dev_redis
REDIS_URL=redis://:mindrouter_dev_redis@localhost:6379/0

# If Redis is unreachable, fall back to per-process in-memory rate limiting
# instead of failing open. Leave true for a single-worker dev box; in a
# multi-worker production deployment set it false so a Redis outage does not
# silently drop the fleet-wide limits down to per-worker approximations.
RATE_LIMIT_LOCAL_FALLBACK=true

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
SESSION_COOKIE_NAME=mindrouter_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# API key hash settings
API_KEY_HASH_ALGORITHM=argon2

# Sidecar secret key (required for GPU sidecar agent authentication)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SIDECAR_SECRET_KEY=

# Interactive API docs (Swagger /docs, ReDoc /redoc, /openapi.json). Enabled
# here for local development; DISABLE in production (ENABLE_API_DOCS=false) so
# the full route/schema surface is not published to anonymous callers.
ENABLE_API_DOCS=true

# Extra origins trusted for state-changing (CSRF-protected) browser requests,
# beyond APP_BASE_URL. JSON list of scheme+host origins, e.g.
# ["https://admin.example.edu"]. Empty is correct for a single-origin deploy.
CSRF_TRUSTED_ORIGINS=[]

# =============================================================================
# SECURITY HARDENING / INPUT LIMITS
# =============================================================================
# The defaults below preserve current behavior; they are exposed so an operator
# can tighten them without a code change. Sizes are upper bounds on untrusted
# input and exist to bound memory/CPU per request.

# Image-URL fetching (vision inputs, image edits). Block URLs that resolve to
# private/loopback/link-local addresses to prevent SSRF against internal
# services; restrict which URL schemes are accepted.
IMAGE_URL_BLOCK_PRIVATE=true
IMAGE_URL_ALLOWED_SCHEMES=["http","https","data"]

# Max decoded frames/pages processed per OCR request (multi-page PDFs, etc.).
OCR_MAX_FRAMES=500

# Max uncompressed size of an uploaded chat file after decompression, in MB
# (guards against decompression bombs independent of CHAT_UPLOAD_MAX_SIZE_MB).
CHAT_UPLOAD_MAX_UNCOMPRESSED_MB=100

# Upper bound on the OpenAI-style `n` (number of completions) per request.
MAX_COMPLETIONS_N=8

# Login throttling: max failed attempts per source within the rolling window
# (seconds) before further attempts are refused.
LOGIN_MAX_ATTEMPTS_PER_WINDOW=15
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# Max characters accepted by the /tokenize helper endpoint.
TOKENIZE_MAX_INPUT_CHARS=2000000

# =============================================================================
# SINGLE SIGN-ON (SSO)
# =============================================================================
# MindRouter supports four SSO providers. Each is enabled PURELY by the
# environment variables below -- there is no admin-UI toggle -- and any subset
# may be enabled at once. The login page renders one button per enabled
# provider in a fixed order: Azure AD, SAML, generic OIDC, Google. Local
# username/password accounts are ALWAYS available (collapsed under a "Sign in
# with a local account" toggle). With no provider configured the login page is
# just the local form.
#
# Full admin guide (setup walkthroughs, IdP-side steps, troubleshooting):
#   docs/sso-configuration.md
#
# Notes that apply to every provider:
#   - Set APP_BASE_URL (see APPLICATION section) first. Redirect URIs and the
#     SAML Destination check are derived from it as long as it is set; leaving
#     it blank re-enables header-derived values (the request's scheme / Host --
#     only the OIDC path consults X-Forwarded-Proto), so keep it set.
#   - Config is process-level and cached per worker: RESTART the app after
#     changing any SSO variable. OIDC discovery documents and SAML IdP
#     metadata are additionally cached in-process for 1 hour.
#   - Run `alembic upgrade head` after upgrading (migration 068 adds
#     users.sso_provider / users.sso_subject).
#   - Every variable below is already wired through docker-compose.yml's
#     `environment:` block; put real production values in the host .env file.
#   - JIT provisioning: a first-time SSO user is created with no password and
#     placed in that provider's *_DEFAULT_GROUP. THE GROUP MUST ALREADY EXIST
#     (create it on the admin Groups page); quota is seeded from it.
#   - Account linking is restricted to UNCLAIMED accounts: an existing user
#     matched only by email is adopted only if it carries NO identity yet
#     (no azure_oid, no sso_provider) -- typically a local password account.
#     Otherwise the login is REFUSED (logged as sso_email_link_refused). The
#     refusal is NOT limited to a *different* provider: the SAME provider
#     presenting a NEW subject is refused too, so an IdP that rotates its
#     subject / NameID locks a user out after their first login (see the SAML
#     section). Clearing a stale identity off an account requires direct
#     database access -- there is no admin UI or API for it.
#   - SECRET_KEY (see SECURITY section) signs the OIDC/Google CSRF state cookie
#     and the SAML saml_request_id cookie. A weak or shared key weakens those
#     SSO protections, and rotating it invalidates every in-flight login (users
#     mid-redirect must start over).
#   - SAML support outside Docker requires the optional extra:
#     `pip install -e .[saml]` (install libxmlsec1-dev first). The shipped
#     Docker image already includes it. Without the extra, Azure/Google/OIDC
#     work normally and the SAML routes return a clear "SAML support is not
#     installed" error instead of crashing.

# -----------------------------------------------------------------------------
# Azure AD / Entra ID
# -----------------------------------------------------------------------------
# Set CLIENT_ID and TENANT_ID to enable.
# Routes: GET /login/azure, GET /login/azure/authorized
# GOTCHA: AZURE_AD_REDIRECT_URI is NOT derived from APP_BASE_URL. It must be an
# absolute URL and must match a Redirect URI registered on the Azure app
# registration EXACTLY (scheme, host, path). SET IT EXPLICITLY: the code default
# is only the literal placeholder below, and docker-compose passes the variable
# as ${AZURE_AD_REDIRECT_URI:-}, so under Compose an unset variable arrives as
# an empty string and that placeholder default never applies.
# Azure is the only provider with group mapping from the IdP: the Microsoft
# Graph jobTitle claim is matched case-insensitively ("student" -> students,
# "faculty"/"professor" -> faculty, "staff" -> staff), else the default group.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=https://your-domain.example.com/login/azure/authorized
AZURE_AD_DEFAULT_GROUP=other

# -----------------------------------------------------------------------------
# SAML 2.0 (Shibboleth / InCommon direct, ADFS)
# -----------------------------------------------------------------------------
# Set SAML_SP_ENTITY_ID plus EITHER SAML_IDP_METADATA_URL OR all three of
# SAML_IDP_ENTITY_ID + SAML_IDP_SSO_URL + SAML_IDP_X509_CERT to enable.
# Routes: GET /login/saml (AuthnRequest), POST /login/saml/acs (ACS),
#         GET /saml/metadata (SP metadata XML -- this is the URL you register
#         with the IdP or federation; it 404s when SAML is not configured).
# NOTE: do not read /saml/metadata's 404 vs 501 as "misconfigured vs library
# missing". With SAML_IDP_METADATA_URL set, a missing python3-saml ALSO returns
# 404, because settings are built first and the metadata parser import fails
# there. The 501 "SAML support is not installed" body is only reliably reached
# in the explicit ENTITY_ID/SSO_URL/X509_CERT configuration.
# GOTCHA: SAML_IDP_METADATA_URL MUST be https -- the metadata carries the
# signing certificate, which is the only trust anchor. A plain-http URL
# disables the provider. For a stronger anchor, pin the certificate locally
# with the explicit ENTITY_ID/SSO_URL/X509_CERT trio instead of fetching.
# GOTCHA: SP-INITIATED ONLY. The ACS requires a signed saml_request_id cookie
# from /login/saml and an InResponseTo echoing that AuthnRequest ID, so
# IdP-initiated login (a campus app-portal tile) is NOT SUPPORTED -- users must
# start at the MindRouter login page. Assertions must be signed (strict mode);
# SHA-1 signatures are rejected. There is no Single Logout (SLO).
# GOTCHA: SAML REQUIRES HTTPS. That saml_request_id cookie is set SameSite=None
# and Secure, because the IdP returns the assertion by a CROSS-SITE HTTP-POST to
# the ACS and browsers do not send SameSite=Lax cookies on cross-site POSTs.
# Browsers refuse to store a Secure cookie over plain http, so SAML CANNOT be
# exercised against a plain-http dev URL -- put TLS in front of it even for
# testing. (Azure/OIDC/Google are unaffected; they come back over a redirect.)
# GOTCHA: THE IdP MUST RELEASE A PERSISTENT (OR OTHERWISE STABLE) NameID.
# MindRouter asks for NameIDFormat persistent in its AuthnRequest but does NOT
# verify the format it gets back, and identity is keyed on that NameID. If the
# IdP emits transient/rotating NameIDs, a user logs in successfully exactly ONCE
# (which creates the account) and is PERMANENTLY REFUSED afterwards: the next
# login misses on the new subject, falls back to the email match, and is
# rejected because the account already carries an SSO identity. Recovering such
# an account requires direct database access -- there is no admin UI or API to
# clear a stale identity.
SAML_SP_ENTITY_ID=
# Optional; defaults to <APP_BASE_URL>/login/saml/acs
SAML_SP_ACS_URL=
SAML_IDP_METADATA_URL=
# Explicit alternative to the metadata URL (all three required together)
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_X509_CERT=
SAML_DISPLAY_NAME=SSO
SAML_DEFAULT_GROUP=other

# Assertion attribute mapping (defaults follow eduPerson/InCommon conventions)
SAML_ATTR_EMAIL=mail
SAML_ATTR_NAME=displayName
SAML_ATTR_USERNAME=eduPersonPrincipalName

# -----------------------------------------------------------------------------
# Generic OIDC (Okta, Keycloak, Auth0, CILogon, any spec-compliant IdP)
# -----------------------------------------------------------------------------
# Set ISSUER, CLIENT_ID and CLIENT_SECRET to enable.
# Routes: GET /login/oidc, GET /login/oidc/authorized
# Endpoints are discovered from <issuer>/.well-known/openid-configuration on
# first login and cached in-process for 1 hour; the IdP must publish a userinfo
# endpoint. Claims used: sub (stable subject), email (required), name,
# preferred_username. A login is rejected when the IdP sends email_verified and
# it is not true; IdPs that omit the claim entirely are trusted.
#
# INCOMMON: the recommended path is CILogon as the generic OIDC issuer. CILogon
# is an OIDC gateway fronting the entire InCommon federation, so ONE client
# registration replaces per-campus SAML metadata exchange, and users pick their
# home institution on the CILogon page. Register a client at cilogon.org with
# callback <APP_BASE_URL>/login/oidc/authorized, then set:
#   OIDC_SSO_ISSUER=https://cilogon.org
#   OIDC_SSO_DISPLAY_NAME=InCommon
# Native SAML above remains available for orgs that require direct federation
# with their own Shibboleth IdP.
OIDC_SSO_ISSUER=
OIDC_SSO_CLIENT_ID=
OIDC_SSO_CLIENT_SECRET=
# Optional; defaults to <APP_BASE_URL>/login/oidc/authorized
OIDC_SSO_REDIRECT_URI=
# Login button reads "Sign in with <display name>"
OIDC_SSO_DISPLAY_NAME=SSO
OIDC_SSO_SCOPES=openid profile email
OIDC_SSO_DEFAULT_GROUP=other

# -----------------------------------------------------------------------------
# Google (OIDC)
# -----------------------------------------------------------------------------
# Set CLIENT_ID and CLIENT_SECRET to enable.
# Routes: GET /login/google, GET /login/google/authorized
# The button always reads "Sign in with Google".
# GOOGLE_SSO_HOSTED_DOMAIN optionally restricts login to a single Google
# Workspace domain: it is passed as hd= on the authorize request AND the hd
# claim is enforced server-side on callback. As with generic OIDC, a login is
# rejected when email_verified is sent and is not true; an omitted claim is
# trusted.
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
# Optional; defaults to <APP_BASE_URL>/login/google/authorized
GOOGLE_SSO_REDIRECT_URI=
# Optional Workspace domain restriction, e.g. example.edu
GOOGLE_SSO_HOSTED_DOMAIN=
GOOGLE_SSO_DEFAULT_GROUP=other

# =============================================================================
# HOST STORAGE PATHS (docker-compose bind-mount sources)
# =============================================================================
# These are directories ON THE DOCKER HOST -- the left-hand side of the compose
# bind mounts. They are NOT the same thing as the in-container *_STORAGE_PATH
# variables (ARTIFACT_STORAGE_PATH below, VIDEO_STORAGE_PATH,
# BRANDING_STORAGE_PATH), which are the paths the app writes to inside the
# container and normally should not change.
# The defaults below are relative to the compose file so a fresh checkout works;
# production deployments usually point them at an absolute path on a large
# volume (the U of I deployment pins all three under /archivedb).
# Docker creates a missing bind source as root and the app runs as uid 1000, so
# create them up front or writes fail after an apparently clean start:
#   mkdir -p <path> && chown -R 1000:1000 <path>
# Archive MariaDB datadir -> /var/lib/mysql in the mariadb-archive container
ARCHIVE_DB_HOST_PATH=./data/archive-mariadb
# Generated images and other artifacts -> /data/artifacts in the app container
ARTIFACT_HOST_PATH=./data/artifacts
# Generated video -> /data/video in the app container
VIDEO_HOST_PATH=./data/video

# =============================================================================
# ARTIFACT STORAGE
# =============================================================================
# In-container path (the mount target of ARTIFACT_HOST_PATH above)
ARTIFACT_STORAGE_PATH=/data/artifacts
ARTIFACT_MAX_SIZE_MB=50
ARTIFACT_RETENTION_DAYS=365

# =============================================================================
# QUOTAS AND LIMITS
# =============================================================================
# Default monthly token budget for new users
DEFAULT_TOKEN_BUDGET_STUDENT=100000
DEFAULT_TOKEN_BUDGET_STAFF=500000
DEFAULT_TOKEN_BUDGET_FACULTY=1000000

# Rate limits
DEFAULT_RPM_STUDENT=30
DEFAULT_RPM_STAFF=60
DEFAULT_RPM_FACULTY=120
DEFAULT_RPM_ADMIN=1000

# Max concurrent requests per user
DEFAULT_MAX_CONCURRENT_STUDENT=2
DEFAULT_MAX_CONCURRENT_STAFF=4
DEFAULT_MAX_CONCURRENT_FACULTY=8
DEFAULT_MAX_CONCURRENT_ADMIN=50

# =============================================================================
# SCHEDULER
# =============================================================================
# Fair-share weights by role
SCHEDULER_WEIGHT_STUDENT=1
SCHEDULER_WEIGHT_STAFF=2
SCHEDULER_WEIGHT_FACULTY=3
SCHEDULER_WEIGHT_ADMIN=10

# Rolling window for usage tracking (seconds)
SCHEDULER_FAIRNESS_WINDOW=300

# Big user deprioritization threshold (% of cluster in window)
SCHEDULER_DEPRIORITIZE_THRESHOLD=0.5

# Backend scoring weights
SCHEDULER_SCORE_MODEL_LOADED=100
SCHEDULER_SCORE_LOW_UTILIZATION=50
SCHEDULER_SCORE_SHORT_QUEUE=30
SCHEDULER_SCORE_HIGH_THROUGHPUT=20

# =============================================================================
# BACKEND REGISTRY
# =============================================================================
# Polling interval for backend capability refresh (seconds)
BACKEND_POLL_INTERVAL=30

# Health check timeout (seconds)
BACKEND_HEALTH_TIMEOUT=5

# Consecutive failures before marking unhealthy
BACKEND_UNHEALTHY_THRESHOLD=3

# =============================================================================
# REQUEST HANDLING
# =============================================================================
# Maximum request body size (bytes)
MAX_REQUEST_SIZE=52428800

# Default timeout for backend requests (seconds)
BACKEND_REQUEST_TIMEOUT=300

# How long a backend's stream may stay silent AFTER it has started sending
# (seconds). The wait for the first byte stays at the per-attempt timeout.
# Raise it for models that buffer long tool calls; keep it below the front
# proxy's proxy_read_timeout (720 s in nginx/nginx.conf).
BACKEND_STREAM_IDLE_TIMEOUT=600

# Structured output validation
STRUCTURED_OUTPUT_RETRY_ON_INVALID=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/mindrouter/app.log

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PROMPTS=true
AUDIT_LOG_RESPONSES=true

# =============================================================================
# OBSERVABILITY
# =============================================================================
METRICS_ENABLED=true
METRICS_PREFIX=mindrouter

# Tracing (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# DEVELOPMENT
# =============================================================================
DEBUG=false
RELOAD=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# =============================================================================
# TOKENIZER
# =============================================================================
# Default tokenizer for token estimation when backend doesn't report usage
DEFAULT_TOKENIZER=cl100k_base
